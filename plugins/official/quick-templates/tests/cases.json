  {
    "name": "title-markdown-links-html-entities-and-heading-markers-stay-literal",
    "input": {
      "api": 2,
      "scope": "document",
      "text": "Draft",
      "selection": { "start": 0, "end": 0 },
      "params": { "template": "daily_journal", "language": "en", "title": "# ![cover](file) <img> &copy; **bold** ##" }
    },
    "expectedResult": {
      "kind": "text",
      "text": "# \\# \\!\\[cover\\](file) \\<img\\> \\&copy; \\*\\*bold\\*\\* \\#\\#\n\n**Date:**\n\n## What happened\n\n## Reflections\n\n## Tomorrow\n"
    }
  },
  {
    "name": "title-wiki-highlight-interpolation-and-trailing-backslash-stay-literal",
    "input": {
      "api": 2,
      "scope": "document",
      "text": "",
      "selection": { "start": 0, "end": 0 },
      "params": { "template": "daily_journal", "language": "en", "title": "[[wiki]] ==mark== `${title}` {{body}} \\" }
    },
    "expectedResult": {
      "kind": "text",
      "text": "# \\[\\[wiki\\]\\] \\=\\=mark\\=\\= \\`\\$\\{title\\}\\` \\{\\{body\\}\\} \\\\\n\n**Date:**\n\n## What happened\n\n## Reflections\n\n## Tomorrow\n"
    }
  },
